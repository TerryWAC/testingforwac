# Supabase — from your project's Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Server-only. NEVER expose to the client or commit real values.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Server-only. Optional — without it the app uses the deterministic engine only.
GEMINI_API_KEY=

# Server-only. Optional — enables real movie posters via TMDB (themoviedb.org
# → Settings → API). Without it the app shows designed typographic cards.
TMDB_API_KEY=
